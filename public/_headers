# Cloudflare static-assets headers — https://developers.cloudflare.com/workers/static-assets/headers/

# Vite fingerprints everything under /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The wasm binaries live in public/ and are copied through UNHASHED, so a new
# build reuses the same filenames. A short cache keeps a redeploy from serving
# yesterday's kernel out of a CDN edge.
/*.wasm
  Cache-Control: public, max-age=300, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Cross-origin isolation. COOP alone is not enough — SharedArrayBuffer needs
  # both, and with them the door is open to real wasm threads (the project has
  # listed that as unreachable since v1). COEP costs nothing here: the app
  # loads no third-party resource at all.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  # 'wasm-unsafe-eval' is what lets WebAssembly.instantiate run at all;
  # worker-src covers the four engine workers; blob: is for the PNG download.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
