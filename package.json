{
  "name": "mandelbrot-explorer-wasm-ts",
  "private": true,
  "version": "1.0.0",
  "description": "A Mandelbrot/Julia explorer comparing the same escape-time kernel in Go/WebAssembly and in TypeScript",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.3+sha512.1f79bc245a66eb0b07c5d4d83131240774642caaa86ef7d0434ab47c0d16f66b04e21e0c086eb61e62c77efc4d7f7ec071afad3796af64892fae66509173893a",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build:wasm": "cd go && GOOS=js GOARCH=wasm go build -o ../public/main.wasm"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "framer-motion": "^12.12.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.6.2",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
